{
  "expo": {
    "name": "MyQRLWallet",
    "slug": "myqrlwallet",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/myqrlwallet/applogo.png",
    "scheme": [
      "qrlconnect"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chiefdg.myqrlwallet",
      "buildNumber": "3",
      "associatedDomains": [
        "applinks:qrlwallet.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "This app uses Face ID to secure your wallet access.",
        "NSCameraUsageDescription": "This app needs camera access to scan QR codes for wallet addresses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/myqrlwallet/adaptive-icon.png",
        "backgroundImage": "./assets/images/myqrlwallet/adaptive-icon-background.png"
      },
      "package": "com.chiefdg.myqrlwallet",
      "versionCode": 3,
      "allowBackup": false,
      "permissions": [
        "USE_FINGERPRINT",
        "USE_BIOMETRIC",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qrlwallet.com",
              "path": "/connect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/myqrlwallet/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/myqrlwallet/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0c0e10"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "This app needs camera access to scan QR codes for wallet addresses.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MyQRLWallet to use Face ID to secure your wallet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "26be16de-5d6b-4ec7-96f5-b661524704b7"
      }
    }
  }
}
